; Contexts as egglog terms, mirroring `rows::Context`.
;
; Sets are cons lists in the order of Rust's `BTreeSet`s: Rust keeps them
; canonical, so equal sets are one e-class. A term is an opaque leaf keyed
; by its canonical text; Rust keeps the expression.

(datatype Rel)
(datatype Rels (RNil) (RCons Rel Rels))
(datatype Term (T String))
(datatype Terms (TNil) (TCons Term Terms))
(datatype Strs (SNil) (SCons String Strs))
; An existence condition: kind ("semi", "anti", "not in"), on, other.
(datatype Ex (Exist String Terms Rel))
(datatype Exs (ENil) (ECons Ex Exs))

; `Context::Spj { tables, atoms, preds, exists }`.
(constructor Spj (Strs Rels Terms Exs) Rel)
; `Context::Derived { op, args, inputs }`.
(constructor Derived (String Terms Rels) Rel)
